[metadata]
version = "0.1.0"
last-updated = "2026-10-03"

[project]
name = "Stateful Artefacts"
purpose = "State-carrying artefact layer of the Reposystem/OPSM stack: schemas and tooling for artefacts that carry machine-readable state (identity, provenance, lifecycle, verification) across the hyperpolymath estate."

[ai-allocation]
agents = [
  { name = "CLAUDE", role = "proofs, compilers, repo-local implementation, CI/CD, formal verification, Rust/Idris2/Zig" },
  { name = "CHATGPT", role = "prose, papers, publication review, standards docs, outreach drafts, letters" },
  { name = "GEMINI", role = "estate audits, cross-repo sweeps, long-context triage, pattern detection" },
  { name = "VIBE", role = "UI/frontend, PanLL panels, ReScript components, theming, rapid prototyping" },
]

[policy]
rules = [
  "Do not duplicate tasks across sections. If a task needs multiple LLMs, note the handoff.",
  "Update THIS file during sessions. Do NOT recreate per-repo TODO files.",
]

[work-allocation]
items = [
  { agent = "CLAUDE", task = "proofs, compilers, repo-local implementation, CI/CD, formal verification, Rust/Idris2/Zig" },
  { agent = "CHATGPT", task = "prose, papers, publication review, standards docs, outreach drafts, letters" },
  { agent = "GEMINI", task = "estate audits, cross-repo sweeps, long-context triage, pattern detection" },
  { agent = "VIBE", task = "UI/frontend, PanLL panels, ReScript components, theming, rapid prototyping" },
]

[session-2026-10-03]
task = "Issue #66 / D183: README-derived repository description, drift prevention, and CI dependency audit"
status = "PR #69 merged externally by hyperpolymath as d457edf on 2026-10-03; #66 was closed but live description remains null. Main has failing description, estate-audit, UUID and Sonar checks. Follow-up source security fixes and registry reconciliation findings are in this branch; no clean-main claim."

upstream-patch = "docs/upstream/cicd-suite-42.patch; 18 local regression cases pass; upstream push/PR creation denied with HTTP 403"
optional-work = "Wiki-format policy reconciled and tested; real ReleaseSafe packaging and non-publishing CI dry run replace release template. No release or OIDC/provenance verification claimed."
identity-decision = "Registry inspection found a DIFFERENT registered UUID and clade rm (gv-clade-index#98). Classification reconciled; UUID unchanged pending consumer inventory and reviewed alias/migration."

validation-boundary = "PR check rollups omit some Actions startup failures. Native lock fully regenerated from unchanged SHA set; inspect run conclusions separately. Initial hosted release dry run failed startup despite local packaging success."
