# SPDX-License-Identifier: MPL-2.0
# OPTIONAL: VeriSimDB feed — provisional local state-record export.
# Current VeriSimDB lives at hyperpolymath/verisimdb and exposes an Octad API.
# Generic terminology: a deployment's selection is a modality profile; its
# cardinality is implementation-specific. No v0-to-profile mapping or sink is agreed.
# The current emit flags are disabled; the local script still writes only its provisional file.

[integration]
name = "verisimdb"
type = "local-export"
# Contract reference only; this configuration has no remote sink.
repository = "https://github.com/hyperpolymath/verisimdb"

[feed-config]
emit-scan-results = false
emit-build-metrics = false
emit-dependency-graph = false
format = "provisional-v0"
destination = "verisimdb-data/feeds/"
