# ECOSYSTEM.a2ml — Ecosystem position

[metadata]
project = "stateful-artefacts"
ecosystem = "hyperpolymath"

[position]
type = "library"
purpose = "State-carrying artefact layer of the Reposystem/OPSM stack: canonical schemas and cross-language tooling (Idris2-proven layout, Zig C ABI) for artefacts that carry machine-readable state across the estate."

[pipeline]
position = "component"
chain = "standards → rsr-template-repo → stateful-artefacts"
notes = "Instantiated from rsr-template-repo on 2026-07-02. Extracted from hyperpolymath/reposystem (the original content transfer failed and is being redone; see STATE.a2ml blockers)."
coordination = "reposystem"

[related-projects]
projects = [
  { name = "reposystem", relationship = "extraction-parent", notes = "Railway-yard estate coordination tool this repo was split out of; the domain content is re-transferred from there." },
  { name = "standards", relationship = "standard-source", notes = "Defines the RSR standard, contractile canon, and policies this repo follows." },
  { name = "rsr-template-repo", relationship = "template-parent", notes = "Scaffolding this repo was instantiated from via `just init`." },
  { name = "nextgen-databases", relationship = "data-feed-target", notes = "VeriSimDB is the aggregation sink for artefact state records (hexad feed format)." },
  { name = "git-hud", relationship = "stack-peer", notes = "OPSM stack HUD; consumes Reposystem exports that carry stateful-artefacts records." },
  { name = "vordr", relationship = "verification-tooling", notes = "Build/artifact verification; natural consumer of artefact state records." },
]
