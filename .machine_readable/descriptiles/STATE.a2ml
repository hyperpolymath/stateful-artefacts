# STATE.a2ml — Project state checkpoint

[metadata]
project = "stateful-artefacts"
version = "0.1.0"
last-updated = "2026-07-03"
status = "active"  # active | paused | archived

[project-context]
name = "stateful-artefacts"
purpose = "State-carrying artefact layer of the Reposystem/OPSM stack: schemas and tooling for artefacts that carry machine-readable state (identity, provenance, lifecycle, verification) across the hyperpolymath estate. PROVISIONAL definition — refine on content re-transfer from hyperpolymath/reposystem."
completion-percentage = 45

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "alpha"         # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase A: Template instantiation and identity", completion = 100 },
  { name = "Phase B: Repair template defects (ABI drift, validators, missing docs)", completion = 100 },
  { name = "Phase C: ABI/FFI seam builds and passes tests (Zig + Idris2)", completion = 100 },
  { name = "Phase D: v0 artefact-state-record (schema + Zig core + lifecycle proofs)", completion = 90 },
  { name = "Phase E: Re-transfer domain content from hyperpolymath/reposystem", completion = 0 },
  { name = "Phase F: VeriSimDB live feed + estate registrations (local stub done)", completion = 10 },
]

[blockers-and-issues]
issues = [
  "Original content transfer out of hyperpolymath/reposystem failed; only the RSR template shell landed here. Domain code must be re-transferred by the maintainer.",
  "License discrepancy: reposystem declares PMPL-1.0; this repo is normalised to MPL-2.0 (code) + CC-BY-SA-4.0 (docs). Needs a maintainer decision.",
]

[critical-next-actions]
actions = [
  "Get an idris2 toolchain into CI so the ABI/Record typecheck (just typecheck-abi) runs on every change (currently dev/CI-local only; see AFFIRMATION)",
  "Re-transfer the stateful-artefacts slice from hyperpolymath/reposystem into src/core, reconciling it with the v0 artefact-state-record (maintainer-only; see README)",
  "Register groove port in standards PORT-REGISTRY and clade prefix in gv-clade-index; upstream the estate V/Zig naming-check fix to standards",
  "Resolve PMPL-1.0 vs MPL-2.0 licensing question",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["Reposystem/OPSM stack", "RSR Framework"]
depends-on = ["reposystem", "nextgen-databases", "standards"]
